{
  "name": "stellar-payment-ui",
  "version": "0.1.0",
  "description": "Drop-in React components for Stellar payments: balance display, send form, receive QR, and transaction history.",
  "type": "module",
  "main": "dist/stellar-payment-ui.cjs.js",
  "module": "dist/stellar-payment-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/stellar-payment-ui.es.js",
      "require": "./dist/stellar-payment-ui.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@stellar/freighter-api": "^2.0.0",
    "qrcode.react": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "keywords": ["stellar", "react", "payments", "wallet", "freighter", "ui-components", "soroban"],
  "license": "MIT"
}
