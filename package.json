{
  "name": "stellar-payment-ui",
  "version": "0.1.0",
  "description": "React components for Stellar payments, plus an optional Rust/Soroban escrow contract.",
  "homepage": "https://github.com/Mike008-Div/stellar_payment_ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mike008-Div/stellar_payment_ui.git"
  },
  "type": "module",
  "main": "dist/stellar-payment-ui.cjs.js",
  "module": "dist/stellar-payment-ui.es.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/stellar-payment-ui.es.js",
      "require": "./dist/stellar-payment-ui.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist", "src/index.d.ts"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:test": "cargo test -p stellar-payment-escrow",
    "contract:format": "cargo fmt --all -- --check",
    "contract:build": "cargo build -p stellar-payment-escrow --target wasm32-unknown-unknown --release"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@stellar/freighter-api": "^2.0.0",
    "qrcode.react": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "jsdom": "^24.1.1"
  },
  "keywords": ["stellar", "react", "payments", "wallet", "freighter", "ui-components", "soroban", "rust", "escrow"],
  "license": "MIT"
}
